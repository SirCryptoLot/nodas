---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import { article, breadcrumbs } from '../lib/seo';
import { fillPrices } from '../lib/fillPrices';

export async function getStaticPaths() {
  const all = await getCollection('gidai');
  return all.map((entry) => ({ params: { slug: entry.id }, props: { entry, all } }));
}

const { entry, all } = Astro.props;
const html = fillPrices(entry.rendered?.html ?? '');
const path = `/${entry.id}`;
const crumbs = [{ name: 'Pradžia', path: '/' }, { name: 'Gidai', path: '/#gidai' }, { name: entry.data.h1, path }];
const related = entry.data.related
  .map((p: string) => {
    const g = all.find((x: { id: string }) => '/' + x.id === p);
    return g ? { href: p, title: g.data.h1 } : null;
  })
  .filter(Boolean) as { href: string; title: string }[];
---
<Base
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  jsonld={[
    article({ title: entry.data.h1, description: entry.data.description, path, date: entry.data.date }, SITE),
    breadcrumbs(crumbs.filter((c) => !c.path.includes('#')), SITE),
  ]}
>
  <article class="section page-head guide">
    <div class="wrap narrow">
      <Breadcrumbs items={crumbs} />
      <h1>{entry.data.h1}</h1>
      <p class="guide-meta">Atnaujinta {entry.data.date}</p>
      <div class="prose" set:html={html} />
      <div class="guide-cta card">
        <h2 class="h3">Kitas žingsnis</h2>
        <p>Pasitikrinkite skaičiuoklėje, kokios įrangos reikia, arba parašykite mums: pasiūlymą su kaina atsiųsime nemokamai.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/kontaktai">Gauti pasiūlymą</a>
          <a class="btn btn-secondary" href="/skaiciuokle">Skaičiuoklė</a>
        </div>
      </div>
      {related.length > 0 && (
        <nav class="related" aria-label="Susiję gidai">
          <h2 class="h3">Susiję</h2>
          <ul>{related.map((r) => <li><a href={r.href}>{r.title}</a></li>)}</ul>
        </nav>
      )}
    </div>
  </article>
  <CtaBand />
</Base>
