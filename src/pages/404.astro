---
import Base from '../layouts/Base.astro';
---
<Base title="Puslapis nerastas" description="Tokio puslapio nėra. Grįžkite į pradžią arba peržiūrėkite AI įrangą ir paslaugas." path="/404">
  <section class="section page-head">
    <div class="wrap narrow">
      <p class="eyebrow">404</p>
      <h1>Tokio puslapio nėra</h1>
      <p class="lead">Galbūt nuoroda pasenusi. Pabandykite nuo pradžios.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Į pradžią</a>
        <a class="btn btn-secondary" href="/iranga">AI įranga</a>
      </div>
    </div>
  </section>
</Base>
